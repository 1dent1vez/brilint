---
// Formulario de contacto en Astro puro
---

<form
  id="contact-form"
  class="space-y-4 bg-dab-surface p-5 sm:p-6 rounded-2xl border border-dab-accent/60 shadow-dab-soft max-w-xl mx-auto"
>
  <!-- Honeypot check -->
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
  <!-- Web3Forms Access Key -->
  <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY} />
  <!-- Subject -->
  <input type="hidden" name="subject" value="Nuevo mensaje desde Dab" />

  <div class="space-y-1">
    <label for="contact-name" class="block font-body text-sm font-medium text-dab-muted">
      Tu nombre
    </label>
    <input
      type="text"
      id="contact-name"
      name="name"
      required
      maxlength="80"
      class="w-full font-body bg-dab-bg border border-dab-border p-3 rounded-lg text-base text-dab-text placeholder-dab-muted/50 focus:outline-none focus:ring-2 focus:ring-dab-accent/40 transition-colors"
      placeholder="Cómo te llamas"
    />
  </div>

  <div class="space-y-1">
    <label for="contact-email" class="block font-body text-sm font-medium text-dab-muted">
      Tu correo electrónico
    </label>
    <input
      type="email"
      id="contact-email"
      name="email"
      required
      maxlength="120"
      class="w-full font-body bg-dab-bg border border-dab-border p-3 rounded-lg text-base text-dab-text placeholder-dab-muted/50 focus:outline-none focus:ring-2 focus:ring-dab-accent/40 transition-colors"
      placeholder="correo@ejemplo.com"
    />
  </div>

  <div class="space-y-1">
    <label for="contact-message" class="block font-body text-sm font-medium text-dab-muted">
      Tu mensaje
    </label>
    <textarea
      id="contact-message"
      name="message"
      required
      maxlength="1000"
      rows="4"
      class="w-full font-body bg-dab-bg border border-dab-border p-3 rounded-lg text-base text-dab-text placeholder-dab-muted/50 focus:outline-none focus:ring-2 focus:ring-dab-accent/40 transition-colors resize-none"
      placeholder="Cuéntame qué necesitas"
    ></textarea>
  </div>

  <button
    type="submit"
    id="contact-submit"
    class="w-full font-body bg-dab-accent text-dab-bg rounded-lg py-2.5 sm:py-3 font-semibold text-sm transition duration-fast hover:bg-dab-accent/90 disabled:opacity-60 disabled:cursor-not-allowed active:scale-[0.98]"
  >
    Enviar mensaje
  </button>

  <div id="contact-result" class="text-center text-sm hidden mt-4"></div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const resultDiv = document.getElementById('contact-result') as HTMLDivElement | null;

  if (form && submitBtn && resultDiv) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Disable button and show sending status
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';
      resultDiv.className = 'text-center text-sm text-dab-muted mt-4';
      resultDiv.textContent = 'Enviando mensaje...';
      resultDiv.classList.remove('hidden');

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });
        const data = await response.json();

        if (response.ok && data.success) {
          // Success state
          resultDiv.className = 'text-center text-sm text-emerald-400 mt-4';
          resultDiv.textContent = '¡Mensaje enviado! Te contactaremos pronto.';
          form.reset();
        } else {
          throw new Error(data.message || 'Error al enviar');
        }
      } catch (error) {
        // Error state
        resultDiv.className = 'text-center text-sm text-red-400 mt-4';
        resultDiv.textContent = 'Hubo un error. Por favor, contáctanos por WhatsApp.';
        console.error('Contact form submission error:', error);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar mensaje';
      }
    });
  }
</script>
