---
import Container from '../ui/Container.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import ContactForm from './ContactForm.astro';
---

<section id="contacto" class="py-16 md:py-section-y bg-dab-bg relative">
  <div class="liquid-aurora" aria-hidden="true"></div>
  <Container className="px-3 sm:px-0 space-y-7 md:space-y-9">
    <SectionTitle
      title="Hablemos de tu proyecto"
      subtitle="Cotizaciones rápidas y claras. Atención por WhatsApp o formulario."
    />

    <div class="max-w-xl mx-auto">
      <ContactForm />
    </div>
  </Container>
</section>
