---
import { Image } from 'astro:assets';
const { proyecto } = Astro.props;
---
<article
  class={`rounded-2xl liquid-surface ${proyecto.destacado ? 'liquid-surface--accent' : ''} p-4 sm:p-5 flex flex-col gap-4 md:gap-5 shadow-dab-soft`}
>

  <div class="space-y-1.5">
    <p class="text-[10px] sm:text-xs uppercase tracking-[0.18em] text-dab-muted/80">
      {proyecto.tipo}
    </p>
    <h3 class="text-lg sm:text-xl font-semibold text-dab-text leading-snug">
      {proyecto.titulo}
    </h3>
    {proyecto.zona && (
      <p class="text-[11px] sm:text-xs text-dab-muted/80">
        Zona: {proyecto.zona}
      </p>
    )}
    <p class="text-sm text-dab-muted leading-relaxed">
      {proyecto.descripcion}
    </p>
  </div>

  <div class="rounded-xl liquid-border overflow-hidden h-72 sm:h-80">
    {proyecto.mockup ? (
      <div class="h-full overflow-y-auto">
        <Image
          src={proyecto.mockup}
          alt={`Mockup de ${proyecto.titulo}`}
          width={800}
          height={1600}
          class="w-full object-top"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="h-full overflow-y-auto">
        <Image
          src={proyecto.imagen}
          alt={`Vista de ${proyecto.titulo}`}
          width={800}
          height={500}
          class="w-full object-top"
          loading="lazy"
        />
      </div>
    )}
  </div>

  <div class="flex flex-wrap gap-3">
    {proyecto.url && proyecto.url !== '#' && (
      <a
        href={proyecto.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-dab-accent px-4 py-2 text-xs font-semibold text-dab-bg hover:bg-dab-accent/90 transition"
      >
        Ver sitio en vivo
      </a>
    )}
    {proyecto.repo && (
      <a
        href={proyecto.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full liquid-border px-4 py-2 text-xs font-semibold text-dab-text hover:text-dab-accent transition"
      >
        Ver código
      </a>
    )}
  </div>
</article>
