---
import Container from '../ui/Container.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';
import { WHATSAPP_URL } from '../../config/contact';
---

<section id="servicios" class="py-16 md:py-section-y bg-dab-bg">
  <Container className="space-y-8 md:space-y-10 text-center">
    <SectionTitle
      title="Todo lo que hacemos por tu negocio"
      subtitle="No vendemos paquetes cerrados. Detectamos las necesidades de tu negocio y armamos la solución a tu medida con los servicios que ofrecemos."
    />

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <Button
        href="/servicios"
        variant="primary"
        class="font-body font-medium text-sm"
      >
        Ver servicios
      </Button>
      <Button
        href={WHATSAPP_URL('Hola, quiero armar mi paquete a medida')}
        variant="ghost"
        class="font-body font-medium text-sm"
      >
        Hablar con DAB
      </Button>
    </div>
  </Container>
</section>
