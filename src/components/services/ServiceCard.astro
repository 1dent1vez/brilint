---
import type { Service } from '../../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;

const borderStyles = {
  amber: 'hover:border-dab-amber/40 hover:shadow-[0_0_40px_rgba(245,158,11,0.08)]',
  cyan: 'hover:border-dab-cyan/40 hover:shadow-[0_0_40px_rgba(34,211,238,0.08)]',
  rose: 'hover:border-dab-rose/40 hover:shadow-[0_0_40px_rgba(244,63,94,0.08)]',
};

const badgeStyles = {
  amber: 'text-dab-amber border-dab-amber/30 bg-dab-amber/10',
  cyan: 'text-dab-cyan border-dab-cyan/30 bg-dab-cyan/10',
  rose: 'text-dab-rose border-dab-rose/30 bg-dab-rose/10',
};

const bgIconStyles = {
  amber: 'bg-dab-amber/10 border-dab-amber/20 text-dab-amber',
  cyan: 'bg-dab-cyan/10 border-dab-cyan/20 text-dab-cyan',
  rose: 'bg-dab-rose/10 border-dab-rose/20 text-dab-rose',
};

const activeScale = 'active:scale-[0.98] transition-all duration-300';
---

<a href={`/servicios/${service.slug}`} class={`group block h-full ${activeScale}`}>
  <article class={`glass-card rounded-2xl p-6 sm:p-8 transition duration-300 flex flex-col h-full ${borderStyles[service.color]}`}>
    <div class={`w-12 h-12 rounded-xl border flex items-center justify-center text-2xl mb-5 ${bgIconStyles[service.color]}`}>
      {service.icon}
    </div>
    
    <div class="space-y-2 flex-1">
      <span class={`text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 border rounded-full ${badgeStyles[service.color]}`}>
        {service.badge}
      </span>
      <h3 class="font-body text-2xl font-bold tracking-tight mt-3 text-white">
        {service.name}
      </h3>
      <p class="font-body text-sm text-dab-muted leading-relaxed">
        {service.teaser}
      </p>
    </div>
    
    <div class={`mt-6 inline-flex items-center text-sm font-semibold group-hover:gap-2 transition-all text-white`}>
      <span>Ver planes</span>
      <span class={`ml-1 text-white opacity-60 group-hover:opacity-100 transition-opacity`}>→</span>
    </div>
  </article>
</a>
