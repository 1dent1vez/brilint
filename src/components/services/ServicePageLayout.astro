---
import Nav from '../nav/Nav.astro';
import Footer from '../footer/Footer.astro';
import ServiceSubNav from '../react/ServiceSubNav';
import ServiceTabs from '../react/ServiceTabs';
import Container from '../ui/Container.astro';
import ServiceCard from './ServiceCard.astro';
import { services } from '../../data/services';
import { WHATSAPP_URL } from '../../config/contact';

interface Props {
  service: any;
}

const { service } = Astro.props;

// Filter out current service to show other 2 in cross-sell section
const otherServices = services.filter((s) => s.slug !== service.slug);

// Color style maps
const glowStyles = {
  amber: 'bg-dab-amber',
  cyan: 'bg-dab-cyan',
  rose: 'bg-dab-rose',
};

const badgeStyles = {
  amber: 'text-dab-amber border-dab-amber/30 bg-dab-amber/10',
  cyan: 'text-dab-cyan border-dab-cyan/30 bg-dab-cyan/10',
  rose: 'text-dab-rose border-dab-rose/30 bg-dab-rose/10',
};

const btnPrimaryStyles = {
  amber: 'bg-gradient-to-br from-dab-amber to-amber-600 hover:brightness-110 text-black shadow-[0_0_20px_rgba(245,158,11,0.2)] hover:shadow-[0_0_30px_rgba(245,158,11,0.4)]',
  cyan: 'bg-gradient-to-br from-dab-cyan to-cyan-500 hover:brightness-110 text-black shadow-[0_0_20px_rgba(34,211,238,0.2)] hover:shadow-[0_0_30px_rgba(34,211,238,0.4)]',
  rose: 'bg-gradient-to-br from-dab-rose to-rose-600 hover:brightness-110 text-white shadow-[0_0_20px_rgba(244,63,94,0.2)] hover:shadow-[0_0_30px_rgba(244,63,94,0.4)]',
};

// WhatsApp CTA URL
const whatsappMsg = `Hola Dab, quiero agendar mi diagnóstico gratuito para el servicio de ${service.name}.`;
const whatsappUrl = WHATSAPP_URL(whatsappMsg);
---

<Nav />

<main class="bg-dab-bg pt-[72px] relative overflow-hidden">
  <!-- Glowing Background Mesh for Service Color -->
  <div class={`absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full blur-[140px] pointer-events-none opacity-[0.06] -z-10 ${glowStyles[service.color]}`}></div>

  <!-- Hero Section -->
  <section class="py-16 md:py-24 border-b border-dab-border/40">
    <Container className="text-center space-y-6 md:space-y-8">
      {/* Badge */}
      <div class="inline-flex justify-center animate-fade-up">
        <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border ${badgeStyles[service.color]}`}>
          <span>{service.icon}</span>
          <span>{service.badge}</span>
        </span>
      </div>

      {/* Title */}
      <div class="space-y-4 max-w-4xl mx-auto">
        <h1 class="font-body text-5xl md:text-7xl font-black tracking-tight leading-none text-white uppercase">
          {service.name}
        </h1>
        <p class="font-body text-xl md:text-2xl font-semibold text-dab-text leading-relaxed max-w-2xl mx-auto mt-4 text-pretty">
          {service.tagline}
        </p>
      </div>

      {/* Description */}
      <p class="font-body text-base sm:text-lg text-dab-muted max-w-2xl mx-auto leading-relaxed">
        {service.description}
      </p>

      {/* CTAs */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a
          href="#tabs-section"
          class={`w-full sm:w-auto font-mono text-[14px] font-bold py-3 px-8 rounded-lg leading-none active:scale-[0.98] transition-all flex items-center justify-center gap-2 ${btnPrimaryStyles[service.color]}`}
        >
          Ver planes
        </a>
        <a
          href={whatsappUrl}
          class="w-full sm:w-auto font-mono text-[14px] font-bold py-3 px-8 rounded-lg leading-none border border-dab-border hover:border-dab-accent/40 text-dab-text hover:bg-white/5 active:scale-[0.98] transition-all flex items-center justify-center gap-2"
        >
          Agendar diagnóstico
          <svg class="h-4 w-4 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </Container>
  </section>

  <!-- Sticky Sub-Navigation (Hydrated React component) -->
  <ServiceSubNav client:load activeSlug={service.slug} />

  <!-- Content Tabs Section (Hydrated React component) -->
  <section id="tabs-section" class="py-16 md:py-24 bg-dab-bg relative">
    <Container>
      <ServiceTabs client:load service={service} />
    </Container>
  </section>

  <!-- Cross-Sell Section -->
  <section class="py-16 md:py-24 border-t border-dab-border/60 bg-dab-surface/40">
    <Container className="space-y-10 md:space-y-12">
      <div class="text-center space-y-2">
        <h2 class="font-body text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white uppercase">
          ¿Necesitas algo más?
        </h2>
        <p class="font-body text-sm sm:text-base text-dab-muted max-w-xl mx-auto">
          Explora los otros servicios de la suite digital de DAB y encuentra la solución ideal para tu negocio.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {otherServices.map((otherService) => (
          <ServiceCard service={otherService} />
        ))}
      </div>
    </Container>
  </section>
</main>

<Footer />
