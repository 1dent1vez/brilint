---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { WHATSAPP_URL } from '../../config/contact';
---

<section class="py-16 md:py-section-y bg-brilint-surface">
  <Container className="text-center px-4 sm:px-0 space-y-4 md:space-y-5">
    <h2 class="font-display font-bold text-2xl md:text-3xl uppercase tracking-tight mb-2">
      ¿Listo para evolucionar tu presencia digital?
    </h2>

    <p class="font-body text-brilint-muted max-w-md sm:max-w-xl mx-auto mb-4 sm:mb-6 text-base leading-relaxed">
      Brilint te acompaña desde el diagnóstico hasta la optimización continua.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto">
      <div class="w-full sm:w-auto">
        <Button
          href={WHATSAPP_URL("Hola, quiero una cotización")}
          variant="primary"
          class="font-body"
        >
          Empezar ahora
        </Button>
      </div>
    </div>
  </Container>
</section>
