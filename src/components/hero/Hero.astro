---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { HeroMotion, HeroMotionItem } from '../../react/HeroMotion.jsx';
import { ConstellationBg } from '../../react/ConstellationBg.jsx';
import { WHATSAPP_URL } from '../../config/contact';
---

<section
  id="top"
  class="relative pt-24 pb-16 md:pt-32 md:pb-section-y overflow-hidden min-h-[85vh] md:min-h-[90vh] flex items-center"
  aria-labelledby="hero-title"
>
  <div class="pointer-events-none absolute inset-0 -z-10">
    <ConstellationBg client:load />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_0%,rgba(76,127,255,0.15),transparent)]"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-brilint-bg/40"></div>
  </div>

  <HeroMotion client:load>
    <Container className="relative">
      <div class="grid gap-10 md:gap-16 md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] items-start">
        
        <div class="space-y-7 md:space-y-9 text-center md:text-left relative z-10">
          <HeroMotionItem delay={0}>
            <p class="mx-auto md:mx-0 inline-flex items-center gap-2 text-[11px] tracking-[0.2em] text-brilint-muted/90 uppercase rounded-full border border-brilint-border/50 bg-brilint-surface/40 backdrop-blur-md px-3 py-1.5 shadow-lg shadow-black/5">
              Servicios digitales premium &middot; Valle de Toluca
            </p>
          </HeroMotionItem>

          <HeroMotionItem delay={100}>
            <div class="space-y-5 relative">
              <div class="pointer-events-none absolute left-1/2 md:left-8 top-0 h-32 w-64 -translate-x-1/2 md:translate-x-0 rounded-full bg-brilint-accent/10 blur-3xl"></div>
              <h1 id="hero-title" class="relative text-[2.75rem] leading-[1.05] sm:text-6xl md:text-7xl font-display font-semibold tracking-tight">
                Don't just adapt.
                <span class="text-brilint-accent relative block mt-2">
                  Evolve.
                  <span class="absolute -bottom-2 left-0 md:left-0 h-1 w-20 bg-gradient-to-r from-brilint-accent via-brilint-accent/60 to-transparent rounded-full"></span>
                </span>
              </h1>
              <p class="md:hidden px-4 text-base text-brilint-muted/90 leading-relaxed max-w-md mx-auto">
                Presencia digital, campa&ntilde;as y sistemas confiables para atraer clientes y que tu operaci&oacute;n no falle.
              </p>
              <p class="hidden md:block text-lg leading-relaxed text-brilint-muted/90 max-w-xl">
                Brilint ayuda a PyMEs, profesionales y hogares a construir presencia
                digital, campa&ntilde;as y sistemas tecnol&oacute;gicos confiables para que dejes
                de perder clientes por no estar bien en l&iacute;nea.
              </p>
            </div>
          </HeroMotionItem>

          <HeroMotionItem delay={200}>
            <div class="inline-flex w-full flex-col gap-2 rounded-full border border-brilint-border/50 bg-brilint-surface/30 backdrop-blur-md p-2 shadow-xl shadow-black/10 sm:w-auto sm:flex-row sm:items-center">
              <Button
                href={WHATSAPP_URL("Hola, quiero agendar un diagnóstico para mi negocio")}
                variant="primary"
                class="w-full sm:w-auto hover:scale-[1.02] active:scale-[0.98] hover:shadow-brilint-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brilint-accent/70 transition-transform"
              >
                Agendar diagn&oacute;stico
              </Button>
              <Button
                href="#portfolio"
                variant="ghost"
                class="w-full sm:w-auto hover:scale-[1.01] active:scale-[0.98] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brilint-accent/70 transition-transform"
              >
                Ver portafolio
              </Button>
            </div>
          </HeroMotionItem>

          <HeroMotionItem delay={300}>
            <div class="md:hidden">
              <div class="flex gap-3 overflow-x-auto snap-x snap-mandatory hide-scrollbar justify-center px-1 text-[11px] text-brilint-muted/80">
                <span class="snap-start inline-flex items-center gap-2 rounded-full bg-brilint-surface/40 backdrop-blur-sm px-3 py-1.5 border border-brilint-border/50 transition hover:border-brilint-accent/60 shadow-md shadow-black/5">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50"></span>
                  Respuesta r&aacute;pida por WhatsApp
                </span>
                <span class="snap-start inline-flex items-center gap-2 rounded-full bg-brilint-surface/40 backdrop-blur-sm px-3 py-1.5 border border-brilint-border/50 transition hover:border-brilint-accent/60 shadow-md shadow-black/5">
                  Zona: Metepec &middot; Toluca &middot; Lerma
                </span>
              </div>
            </div>
            <div class="hidden md:flex md:flex-wrap gap-3 text-xs text-brilint-muted/80">
              <span class="inline-flex items-center gap-2 rounded-full bg-brilint-surface/40 backdrop-blur-sm px-3 py-1.5 border border-brilint-border/50 transition hover:border-brilint-accent/60 shadow-md shadow-black/5">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50"></span>
                Respuesta r&aacute;pida por WhatsApp
              </span>
              <span class="inline-flex items-center gap-2 rounded-full bg-brilint-surface/40 backdrop-blur-sm px-3 py-1.5 border border-brilint-border/50 transition hover:border-brilint-accent/60 shadow-md shadow-black/5">
                Zona: Metepec &middot; Toluca &middot; Lerma
              </span>
            </div>
          </HeroMotionItem>

          <HeroMotionItem delay={400} className="md:hidden">
            <div class="relative mt-6">
              <details class="hero-details group relative rounded-2xl border border-brilint-border/50 bg-brilint-surface/60 backdrop-blur-md shadow-xl shadow-black/10">
                <summary class="flex items-center justify-between gap-3 list-none cursor-pointer px-4 py-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brilint-accent/60">
                  <span class="inline-flex items-center gap-2 text-[11px] font-semibold text-brilint-muted/90 uppercase tracking-[0.18em]">
                    Vista r&aacute;pida de servicios
                  </span>
                  <span class="flex h-8 w-8 items-center justify-center rounded-full border border-brilint-border/60 bg-brilint-surface/40 text-brilint-muted transition duration-300 group-open:rotate-45 group-open:bg-brilint-accent/10 group-open:border-brilint-accent/40">
                    +
                  </span>
                </summary>
                <div class="px-4 pb-4 pt-1 overflow-hidden max-h-0 opacity-0 translate-y-1 transition-[max-height,opacity,transform] duration-500 ease-out group-open:max-h-[520px] group-open:opacity-100 group-open:translate-y-0">
                  <h3 class="text-sm font-semibold leading-snug text-brilint-foreground">
                    Diagn&oacute;stico &middot; Estrategia &middot; Implementaci&oacute;n &middot; Optimizaci&oacute;n
                  </h3>
                  <ul class="mt-3 space-y-2 text-xs text-brilint-muted/90 leading-relaxed">
                    <li class="flex gap-2">
                      <span class="text-brilint-accent">&bull;</span>
                      <span>Landing pages y campa&ntilde;as Meta/Google para captar clientes.</span>
                    </li>
                    <li class="flex gap-2">
                      <span class="text-brilint-accent">&bull;</span>
                      <span>Redes e internet confiables en hogar y negocio.</span>
                    </li>
                    <li class="flex gap-2">
                      <span class="text-brilint-accent">&bull;</span>
                      <span>Soporte t&eacute;cnico y seguridad digital preventiva.</span>
                    </li>
                  </ul>
                </div>
              </details>
            </div>
          </HeroMotionItem>
        </div>

        <HeroMotionItem delay={350} className="hidden md:block">
          <div class="relative min-h-[480px]">
            <div class="hero-floating-card absolute -top-8 right-0 max-w-md w-full">
              <div class="relative rounded-3xl border border-brilint-border/50 bg-brilint-surface/70 backdrop-blur-xl p-8 shadow-2xl shadow-black/20">
                <div class="pointer-events-none absolute inset-0 rounded-3xl">
                  <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-brilint-accent/50 to-transparent"></div>
                  <div class="absolute -right-16 top-8 h-32 w-32 rounded-full bg-brilint-accent/10 blur-3xl"></div>
                  <div class="absolute -left-12 bottom-12 h-24 w-24 rounded-full bg-brilint-accent/5 blur-2xl"></div>
                </div>

                <div class="relative space-y-5">
                  <p class="inline-flex items-center gap-2 text-xs font-semibold text-brilint-muted/90 uppercase tracking-[0.16em] rounded-full bg-brilint-bg/40 backdrop-blur-sm px-3 py-1.5 border border-brilint-border/40 shadow-sm shadow-black/5">
                    Vista r&aacute;pida de servicios
                  </p>
                  <h3 class="text-xl font-semibold leading-snug text-brilint-foreground">
                    Diagn&oacute;stico &middot; Estrategia &middot; Implementaci&oacute;n &middot; Optimizaci&oacute;n
                  </h3>
                  <ul class="space-y-3 text-sm text-brilint-muted/90 leading-relaxed">
                    <li class="flex gap-2.5 items-start">
                      <span class="text-brilint-accent mt-0.5">&bull;</span>
                      <span>Landing pages y campa&ntilde;as Meta/Google para captar clientes.</span>
                    </li>
                    <li class="flex gap-2.5 items-start">
                      <span class="text-brilint-accent mt-0.5">&bull;</span>
                      <span>Redes e internet confiables en hogar y negocio.</span>
                    </li>
                    <li class="flex gap-2.5 items-start">
                      <span class="text-brilint-accent mt-0.5">&bull;</span>
                      <span>Soporte t&eacute;cnico y seguridad digital preventiva.</span>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </HeroMotionItem>
      </div>
    </Container>
  </HeroMotion>
</section>

<style>
  @keyframes hero-float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(10px, -15px) scale(1.05); }
    66% { transform: translate(-8px, 10px) scale(0.95); }
  }

  @keyframes hero-float-slow {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-12px, -20px) scale(1.1); }
  }

  .hero-floating-card {
    animation: hero-float 14s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-floating-card {
      animation: none;
    }
  }

  .hero-details[open] summary span:last-child {
    transform: rotate(45deg);
  }
</style>