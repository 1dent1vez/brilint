---
import { HERO } from '../../data/hero';
import { ConstellationBg } from '../../react/ConstellationBg.jsx';
import { HeroMotion, HeroMotionItem, BadgeMotion } from '../../react/HeroMotion.jsx';
import LiquidCtaButton from '../../react/LiquidCtaButton.jsx';
---

<section
  id="top"
  class="relative min-h-screen flex items-center justify-center pt-[72px] overflow-hidden bg-dab-bg"
  style="background-image: radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px); background-size: 24px 24px;"
>
  <!-- Background elements -->
  <div class="absolute inset-0 z-0">
    <!-- Central subtle glow -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-dab-accent opacity-[0.03] rounded-full blur-[120px] pointer-events-none"
    >
    </div>
    <!-- 3D Animation Layer (opacity driven by JS timeline) -->
    <div class="absolute inset-0 w-full h-full mix-blend-screen pointer-events-none">
      <ConstellationBg client:load />
    </div>
    <!-- Vignette overlay (reinforced so hero text stays 100% readable) -->
    <div class="absolute inset-0 bg-hero-gradient pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_55%,transparent_0%,rgba(5,6,10,0.55)_70%)] pointer-events-none"></div>
  </div>

  <!-- Simple Badge right below the navbar -->
  <div class="absolute top-[96px] inset-x-0 z-20 pointer-events-none flex justify-center px-5">
    <BadgeMotion client:load delay={0.1}>
      <span class="inline-block font-mono text-[11px] sm:text-[12.5px] font-bold tracking-[0.22em] text-dab-accent uppercase text-center">
        {HERO.badge}
      </span>
    </BadgeMotion>
  </div>

  <!-- Content Container -->
  <div
    class="relative z-10 max-w-[1280px] mx-auto px-5 lg:px-12 w-full grid grid-cols-1 lg:grid-cols-12 gap-6 items-center"
  >
    <!-- Left Content Area -->
    <HeroMotion client:load className="col-span-1 lg:col-span-7 flex flex-col items-start justify-center py-20 lg:py-0">


      <!-- Headline -->
      <HeroMotionItem client:load delay={0.1}>
        <h1
          class="font-sans text-[40px] lg:text-[72px] font-black leading-[1.2] lg:leading-[1.1] tracking-[-0.02em] lg:tracking-[-0.04em] text-dab-text mb-6 max-w-[800px]"
        >
          {HERO.headline.prefix}<span class="text-gradient">{HERO.headline.highlight}</span>{HERO.headline.suffix}
        </h1>
      </HeroMotionItem>

      <!-- Subheadline -->
      <HeroMotionItem client:load delay={0.2}>
        <p class="font-sans text-[18px] leading-[1.6] text-dab-muted mb-10 max-w-[600px]">
          {HERO.subheadline}
        </p>
      </HeroMotionItem>

      <!-- Actions: jerarquía clara (principal hero cobalto full-width, secundario ghost compacto) -->
      <HeroMotionItem client:load delay={0.3} className="w-full sm:w-auto">
        <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto items-center sm:items-center">
          <LiquidCtaButton
            href={HERO.ctas[0].href}
            client:load
            tint="rgba(59, 91, 255, 0.18)"
            textClass="text-dab-cyan"
            class="w-full sm:w-auto px-7 py-4 text-[15px] sm:text-base"
          >
            <span class="flex items-center justify-center gap-2 font-mono font-semibold leading-none tracking-[0.04em]">
              {HERO.ctas[0].label}
              <svg class="h-[18px] w-[18px] text-current fill-current" viewBox="0 -960 960 960" aria-hidden="true">
                <path d="M320-200v-560l440 280-440 280Zm80-280Zm0 134 210-134-210-134v268Z" />
              </svg>
            </span>
          </LiquidCtaButton>
          <a
            href={HERO.ctas[1].href}
            class="group mx-auto sm:mx-0 inline-flex w-auto items-center justify-center gap-2 px-5 py-3 rounded-2xl border border-dab-accent/40 text-dab-accent font-mono text-[13px] sm:text-sm font-medium tracking-[0.04em] bg-dab-accent/5 hover:bg-dab-accent/12 hover:border-dab-accent/60 backdrop-blur-md transition-all duration-200 active:scale-[0.98]"
          >
            {HERO.ctas[1].label}
            <svg class="h-[16px] w-[16px] text-current fill-current transition-transform duration-300 group-hover:translate-x-1" viewBox="0 -960 960 960" aria-hidden="true">
              <path d="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z" />
            </svg>
          </a>
        </div>
      </HeroMotionItem>

      <!-- Burbuja de WhatsApp (sustituye el terminal fake): muestra el valor real del producto -->
      <HeroMotionItem client:load delay={0.4} className="w-full max-w-sm">
        <div class="mt-14 w-full liquid-surface rounded-3xl p-4 sm:p-5 shadow-[0_0_30px_rgba(123,97,255,0.12)]">
          <!-- Header estilo chat -->
          <div class="flex items-center gap-3 mb-3 pb-3 border-b border-dab-border/20">
            <div class="h-9 w-9 rounded-full flex items-center justify-center text-[#25D366] bg-[#25D366]/15">
              <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.464 3.489" />
              </svg>
            </div>
            <div class="leading-tight">
              <p class="text-dab-text font-body font-semibold text-sm">DAB · Asistente IA</p>
              <p class="text-dab-muted font-body text-[11px]">responde al instante</p>
            </div>
            <span class="ml-auto h-2 w-2 rounded-full bg-[#25D366] shadow-[0_0_8px_#25D366]"></span>
          </div>
          <!-- Conversación realista: interacción típica cliente-negocio local -->
          <div class="space-y-2.5">
            <div class="flex justify-start">
              <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-white/5 border border-dab-border/20 px-3.5 py-2 font-body text-[13px] text-dab-text">
                Hola, buenas tardes. ¿Tienen disponible para una limpieza facial el jueves?
              </div>
            </div>
            <div class="flex justify-end">
              <div class="max-w-[85%] rounded-2xl rounded-tr-sm bg-[#25D366]/15 border border-[#25D366]/30 px-3.5 py-2 font-body text-[13px] text-dab-text">
                ¡Hola! Sí, tengo 4:00 pm o 5:30 pm el jueves 🙌
              </div>
            </div>
            <div class="flex justify-start">
              <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-white/5 border border-dab-border/20 px-3.5 py-2 font-body text-[13px] text-dab-text">
                Mejor la de 5:30 por favor
              </div>
            </div>
            <div class="flex justify-end">
              <div class="max-w-[85%] rounded-2xl rounded-tr-sm bg-[#25D366]/15 border border-[#25D366]/30 px-3.5 py-2 font-body text-[13px] text-dab-text">
                Listo, agendado a tu nombre para jueves 5:30 pm ✅ Te mando recordatorio el mismo día.
              </div>
            </div>
            <div class="flex justify-start">
              <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-white/5 border border-dab-border/20 px-3.5 py-2 font-body text-[13px] text-dab-muted">
                Perfecto, muchas gracias 🙏
              </div>
            </div>
            <div class="flex justify-end">
              <div class="max-w-[85%] rounded-2xl rounded-tr-sm bg-[#25D366]/15 border border-[#25D366]/30 px-3.5 py-2 font-body text-[13px] text-dab-text">
                Con gusto, nos vemos el jueves 💆‍♀️
              </div>
            </div>
          </div>
        </div>
      </HeroMotionItem>
    </HeroMotion>

    <!-- Right Spacer for 3D element focus -->
    <div class="col-span-1 lg:col-span-5 hidden lg:block h-full relative">
      <!-- The 3D animation occupies the absolute background, but this empty column ensures the text doesn't overlap the right side where the sphere is typically focused -->
    </div>
  </div>

  <!-- Scroll indicator -->
  <HeroMotionItem
    client:load
    delay={0.8}
    className="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2"
  >
    <span class="font-mono text-[10px] text-dab-muted uppercase tracking-widest">{HERO.scroll}</span>
    <div class="w-[1px] h-12 bg-gradient-to-b from-dab-accent/50 to-transparent"></div>
  </HeroMotionItem>
</section>

<style>
  /* Scoped color and styling tokens not directly in tailwind.config.cjs */
  .text-dab-accent-warm {
    color: #7B61FF;
  }
  .bg-dab-accent-warm {
    background-color: #7B61FF;
  }
  .from-dab-accent-warm {
    --tw-gradient-from: #7B61FF var(--tw-gradient-from-position);
    --tw-gradient-to: rgb(123 97 255 / 0) var(--tw-gradient-to-position);
    --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to);
  }
  .to-dab-accent-warm {
    --tw-gradient-to: #7B61FF var(--tw-gradient-to-position);
  }
  .text-dab-cyan {
    color: #28DFB5;
  }
  .bg-dab-cyan {
    background-color: #28DFB5;
  }
  .border-dab-cyan {
    border-color: #28DFB5;
  }

  /* Scoped Stitch utilities */
  .bg-hero-gradient {
    background-image: radial-gradient(circle at 50% 50%, rgba(11, 13, 20, 0) 0%, #05060A 100%);
  }

  .btn-primary {
    background: linear-gradient(135deg, #608bff, #b3c5ff);
    box-shadow: 0 0 20px rgba(76, 127, 255, 0.2);
    transition: all 0.3s ease;
  }

  .btn-primary:hover {
    box-shadow: 0 0 30px rgba(76, 127, 255, 0.4);
    filter: brightness(1.1);
  }

  .btn-ghost {
    background: rgba(11, 13, 20, 0.4);
    border: 1px solid #4C7FFF;
    backdrop-filter: blur(8px);
    transition: all 0.3s ease;
  }

  .btn-ghost:hover {
    background: rgba(96, 139, 255, 0.1);
  }

  .text-gradient {
    background: linear-gradient(to right, #4C7FFF, #7B61FF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
