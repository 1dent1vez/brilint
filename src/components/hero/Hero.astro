---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { HeroMotion } from '../../react/HeroMotion.jsx';
import { ConstellationBg } from '../../react/ConstellationBg.jsx';
import { WHATSAPP_URL } from '../../config/contact';
import { splitTextToWords } from '../../utils/splitText.js';

const titleWords = splitTextToWords("Sistemas que piensan.");
const subtitleWords = splitTextToWords("Negocios que crecen.");
---

<section
  id="top"
  class="relative min-h-screen flex flex-col overflow-hidden bg-brilint-bg"
  aria-labelledby="hero-title"
>
  <!-- CAPA 0: Grid neural -->
  <div class="neural-grid" aria-hidden="true"></div>
  
  <!-- CAPA 1: Partículas -->
  <div class="pointer-events-none absolute inset-0 z-0">
    <ConstellationBg client:load />
  </div>
  
  <!-- CAPA 2: Gradientes -->
  <div class="absolute inset-0 z-[1] bg-gradient-to-b from-transparent via-brilint-bg/40 to-brilint-bg pointer-events-none"></div>
  <div class="absolute inset-0 z-[1] bg-[radial-gradient(ellipse_60%_40%_at_40%_30%,rgba(76,127,255,0.08),transparent)] pointer-events-none"></div>

  <!-- CAPA 3: Contenido -->
  <HeroMotion client:load className="relative z-10 flex-1 flex items-center pt-20 md:pt-24 pb-12">
    <Container className="w-full">
      <div class="grid gap-8 lg:gap-12 lg:grid-cols-[1fr_0.85fr] items-center">
        
        <!-- COLUMNA IZQUIERDA: Texto -->
        <div class="relative z-10">
          
          <!-- Terminal badge -->
          <div class="mb-6 inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-brilint-surface/80 border border-brilint-border/60 backdrop-blur-sm">
            <span class="flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-xs font-mono tracking-wider text-brilint-muted/80 uppercase">
              <span class="text-emerald-400">●</span> Sistema operativo
            </span>
          </div>

          <!-- Título scramble con THUNDER -->
          <div class="space-y-1 mb-8">
            <h1 id="hero-title" class="hero-title font-display font-bold tracking-tighter leading-[0.85] uppercase">
              <span class="block text-brilint-text" data-scramble="Sistemas que piensan.">
                <span class="scramble-text"></span>
              </span>
              <span class="block text-brilint-accent mt-1 relative" data-scramble="Negocios que crecen.">
                <span class="scramble-text"></span>
                <span class="absolute -bottom-1 left-0 h-[3px] w-20 bg-gradient-to-r from-brilint-accent via-brilint-accent/50 to-transparent rounded-full"></span>
              </span>
            </h1>
          </div>

          <!-- Descripción terminal -->
          <div class="hero-subtitle mb-10 max-w-lg">
            <p class="font-body text-base md:text-lg text-brilint-muted/80 leading-relaxed">
              <span class="text-brilint-accent/60">$</span> <span class="typewriter-line"></span><span class="cursor-blink">_</span>
            </p>
          </div>

          <!-- CTA -->
          <div class="hero-cta flex flex-col sm:flex-row gap-4 items-start sm:items-center mb-10">
            <div class="group relative">
              <div class="absolute -inset-1 bg-gradient-to-r from-brilint-accent via-cyan-400 to-brilint-accent rounded-lg opacity-20 group-hover:opacity-60 blur transition duration-500"></div>
              <Button
                href={WHATSAPP_URL("Hola, quiero automatizar mi negocio")}
                variant="primary"
                class="relative bg-brilint-surface border border-brilint-accent/50 hover:bg-brilint-accent/10 hover:border-brilint-accent transition-all duration-300 font-body text-sm font-medium tracking-wide"
              >
                <span class="text-brilint-accent mr-2">⟩</span>
                INICIAR_DIAGNOSTICO.exe
              </Button>
            </div>
            <a 
              href="#servicios" 
              class="text-xs font-mono text-brilint-muted/60 hover:text-brilint-accent/80 transition-colors tracking-wider group"
            >
              <span class="text-brilint-accent/40 group-hover:text-brilint-accent/80 transition-colors">$</span> cat servicios.txt
            </a>
          </div>

          <!-- Métricas -->
          <div class="grid grid-cols-3 gap-3 md:gap-4 max-w-md">
            <div class="metric-card p-3 rounded-lg bg-brilint-surface/50 border border-brilint-border/30 backdrop-blur-sm relative overflow-hidden group">
              <div class="text-[10px] font-body text-brilint-muted/60 mb-1 uppercase tracking-wider">Latencia</div>
              <div class="text-xl md:text-2xl font-mono font-bold text-brilint-text flex items-baseline gap-1">
                <span class="metric-counter" data-target="15">0</span><span class="text-brilint-accent text-sm">ms</span>
              </div>
              <div class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-brilint-accent/0 via-brilint-accent/40 to-brilint-accent/0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"></div>
            </div>
            <div class="metric-card p-3 rounded-lg bg-brilint-surface/50 border border-brilint-border/30 backdrop-blur-sm relative overflow-hidden group">
              <div class="text-[10px] font-body text-brilint-muted/60 mb-1 uppercase tracking-wider">Automación</div>
              <div class="text-xl md:text-2xl font-mono font-bold text-brilint-text flex items-baseline gap-1">
                <span class="metric-counter" data-target="24">0</span><span class="text-brilint-accent text-sm">/7</span>
              </div>
              <div class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-brilint-accent/0 via-brilint-accent/40 to-brilint-accent/0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"></div>
            </div>
            <div class="metric-card p-3 rounded-lg bg-brilint-surface/50 border border-brilint-border/30 backdrop-blur-sm relative overflow-hidden group">
              <div class="text-[10px] font-body text-brilint-muted/60 mb-1 uppercase tracking-wider">Uptime</div>
              <div class="text-xl md:text-2xl font-mono font-bold text-brilint-text flex items-baseline gap-1">
                <span class="metric-counter" data-target="99">0</span><span class="text-brilint-accent text-sm">.9%</span>
              </div>
              <div class="absolute bottom-0 left-0 h-[2px] w-full bg-gradient-to-r from-brilint-accent/0 via-brilint-accent/40 to-brilint-accent/0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"></div>
            </div>
          </div>
        </div>

        <!-- COLUMNA DERECHA: Dashboard flotante -->
        <div class="hidden lg:block relative h-[520px] perspective-dashboard">
          
          <!-- Conector visual SVG -->
          <svg class="absolute -left-8 top-1/2 -translate-y-1/2 w-16 h-32 opacity-30" viewBox="0 0 64 128" fill="none">
            <path d="M0 64 Q32 64 32 32 T64 0" stroke="url(#lineGradient)" stroke-width="1" stroke-dasharray="4 4" class="animate-dash"/>
            <path d="M0 64 Q32 64 32 96 T64 128" stroke="url(#lineGradient)" stroke-width="1" stroke-dasharray="4 4" class="animate-dash-reverse"/>
            <defs>
              <linearGradient id="lineGradient" x1="0" y1="0" x2="64" y2="0">
                <stop offset="0%" stop-color="#4C7FFF" stop-opacity="0"/>
                <stop offset="50%" stop-color="#4C7FFF" stop-opacity="1"/>
                <stop offset="100%" stop-color="#4C7FFF" stop-opacity="0"/>
              </linearGradient>
            </defs>
          </svg>

          <!-- Panel 1: Chat IA -->
          <div class="dashboard-panel absolute top-0 right-0 w-[260px] rounded-xl bg-brilint-surface/70 border border-brilint-border/40 backdrop-blur-xl shadow-2xl shadow-black/30 overflow-hidden">
            <div class="h-7 bg-brilint-bg/60 flex items-center px-3 gap-1.5 border-b border-brilint-border/30">
              <div class="w-2 h-2 rounded-full bg-red-400/60"></div>
              <div class="w-2 h-2 rounded-full bg-yellow-400/60"></div>
              <div class="w-2 h-2 rounded-full bg-green-400/60"></div>
              <span class="ml-auto text-[9px] font-mono text-brilint-muted/50">agente_v1.2.js</span>
            </div>
            <div class="p-3 space-y-2">
              <div class="flex gap-2">
                <div class="w-5 h-5 rounded-full bg-brilint-accent/20 flex-shrink-0"></div>
                <div class="space-y-1">
                  <div class="h-2 w-24 bg-brilint-border/30 rounded"></div>
                  <div class="h-2 w-16 bg-brilint-border/20 rounded"></div>
                </div>
              </div>
              <div class="flex gap-2 justify-end">
                <div class="space-y-1 text-right">
                  <div class="h-2 w-20 bg-brilint-accent/20 rounded ml-auto"></div>
                  <div class="h-2 w-12 bg-brilint-accent/15 rounded ml-auto"></div>
                </div>
                <div class="w-5 h-5 rounded-full bg-emerald-500/20 flex-shrink-0"></div>
              </div>
              <div class="flex gap-2">
                <div class="w-5 h-5 rounded-full bg-brilint-accent/20 flex-shrink-0"></div>
                <div class="h-2 w-28 bg-brilint-border/30 rounded mt-1.5"></div>
              </div>
              <div class="mt-2 h-6 rounded bg-brilint-bg/50 border border-brilint-border/30 flex items-center px-2">
                <div class="h-1.5 w-8 bg-brilint-accent/30 rounded animate-pulse"></div>
              </div>
            </div>
          </div>

          <!-- Panel 2: Analytics -->
          <div class="dashboard-panel absolute top-[180px] left-0 w-[220px] rounded-xl bg-brilint-surface/70 border border-brilint-border/40 backdrop-blur-xl shadow-2xl shadow-black/30 overflow-hidden">
            <div class="h-7 bg-brilint-bg/60 flex items-center px-3 border-b border-brilint-border/30">
              <span class="text-[9px] font-mono text-brilint-muted/50">analytics.live</span>
            </div>
            <div class="p-3">
              <div class="flex items-end gap-1 h-16 mb-2">
                <div class="w-3 bg-brilint-accent/20 rounded-t animate-bar" style="height: 40%; animation-delay: 0s;"></div>
                <div class="w-3 bg-brilint-accent/30 rounded-t animate-bar" style="height: 65%; animation-delay: 0.2s;"></div>
                <div class="w-3 bg-brilint-accent/40 rounded-t animate-bar" style="height: 45%; animation-delay: 0.4s;"></div>
                <div class="w-3 bg-brilint-accent/50 rounded-t animate-bar" style="height: 80%; animation-delay: 0.6s;"></div>
                <div class="w-3 bg-brilint-accent/60 rounded-t animate-bar" style="height: 55%; animation-delay: 0.8s;"></div>
                <div class="w-3 bg-brilint-accent/40 rounded-t animate-bar" style="height: 70%; animation-delay: 1.0s;"></div>
                <div class="w-3 bg-brilint-accent/70 rounded-t animate-bar" style="height: 90%; animation-delay: 1.2s;"></div>
              </div>
              <div class="flex justify-between text-[9px] font-mono text-brilint-muted/50">
                <span>00:00</span>
                <span class="text-emerald-400/80">+127% ↑</span>
                <span>Now</span>
              </div>
            </div>
          </div>

          <!-- Panel 3: System Status -->
          <div class="dashboard-panel absolute bottom-8 right-4 w-[200px] rounded-xl bg-brilint-surface/70 border border-brilint-border/40 backdrop-blur-xl shadow-2xl shadow-black/30 overflow-hidden">
            <div class="h-7 bg-brilint-bg/60 flex items-center px-3 border-b border-brilint-border/30">
              <span class="text-[9px] font-mono text-brilint-muted/50">system.status</span>
            </div>
            <div class="p-3 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono text-brilint-muted/70">API</span>
                <span class="flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="text-[10px] font-mono text-emerald-400">ONLINE</span>
                </span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono text-brilint-muted/70">DB</span>
                <span class="flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="text-[10px] font-mono text-emerald-400">SYNCED</span>
                </span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-mono text-brilint-muted/70">AGENT</span>
                <span class="flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-brilint-accent animate-pulse"></span>
                  <span class="text-[10px] font-mono text-brilint-accent">ACTIVE</span>
                </span>
              </div>
              <div class="h-px bg-brilint-border/30 my-1"></div>
              <div class="h-1 w-full bg-brilint-bg rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-brilint-accent to-cyan-400 w-[78%] animate-pulse"></div>
              </div>
              <div class="text-[9px] font-mono text-brilint-muted/50 text-right">CPU: 12% | MEM: 34%</div>
            </div>
          </div>

          <!-- Números flotantes decorativos -->
          <div class="absolute top-10 left-4 text-[10px] font-mono text-brilint-accent/20 select-none pointer-events-none">
            00101101<br>11010010<br>00101100
          </div>
          <div class="absolute bottom-20 right-0 text-[10px] font-mono text-brilint-accent/15 select-none pointer-events-none text-right">
            42.194.88.1<br>REQ: 200 OK<br> Lat: 14ms
          </div>

        </div>
      </div>
    </Container>
  </HeroMotion>

  <!-- Scan line -->
  <div class="scan-line" aria-hidden="true"></div>
</section>

<style>
  /* Tamaños responsive para THUNDER */
  .hero-title {
    font-size: clamp(3rem, 8vw, 7rem);
  }

  /* Grid neural */
  .neural-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(76, 127, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(76, 127, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 50% at 50% 0%, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 80% 50% at 50% 0%, black 40%, transparent 80%);
    animation: grid-pulse 4s ease-in-out infinite;
  }

  @keyframes grid-pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  /* Cursor */
  .cursor-blink {
    animation: blink 1s step-end infinite;
    color: #4C7FFF;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Scan line */
  .scan-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(76, 127, 255, 0.3), transparent);
    animation: scan 8s linear infinite;
    pointer-events: none;
    z-index: 5;
  }

  @keyframes scan {
    0% { top: -2px; }
    100% { top: 100%; }
  }

  /* Dashboard panels float */
  .dashboard-panel {
    animation: panel-float 10s ease-in-out infinite;
  }

  .dashboard-panel:nth-child(2) {
    animation-delay: -3s;
    animation-duration: 12s;
  }

  .dashboard-panel:nth-child(3) {
    animation-delay: -6s;
    animation-duration: 14s;
  }

  @keyframes panel-float {
    0%, 100% { transform: translateY(0) rotateX(2deg) rotateY(-2deg); }
    25% { transform: translateY(-10px) rotateX(4deg) rotateY(-1deg); }
    50% { transform: translateY(-4px) rotateX(1deg) rotateY(-3deg); }
    75% { transform: translateY(-12px) rotateX(3deg) rotateY(-2deg); }
  }

  /* Perspective */
  .perspective-dashboard {
    perspective: 1200px;
  }

  /* Barras animadas */
  .animate-bar {
    animation: bar-grow 2s ease-in-out infinite alternate;
  }

  @keyframes bar-grow {
    from { transform: scaleY(0.3); }
    to { transform: scaleY(1); }
  }

  /* SVG dash */
  .animate-dash {
    animation: dash 20s linear infinite;
  }
  .animate-dash-reverse {
    animation: dash 20s linear infinite reverse;
  }

  @keyframes dash {
    to { stroke-dashoffset: -100; }
  }

  /* Metric cards */
  .metric-card {
    transition: all 0.3s ease;
  }
  .metric-card:hover {
    border-color: rgba(76, 127, 255, 0.25);
    box-shadow: 0 0 30px rgba(76, 127, 255, 0.05);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .neural-grid,
    .scan-line,
    .cursor-blink,
    .dashboard-panel,
    .animate-bar,
    .animate-dash,
    .animate-dash-reverse {
      animation: none;
    }
    .scan-line {
      display: none;
    }
  }
</style>

<script>
  // === SCRAMBLE ===
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()_+-=[]{}|;:,.<>?';
  
  function scrambleText(element, finalText, duration = 2000) {
    let startTime = null;
    
    function animate(currentTime) {
      if (!startTime) startTime = currentTime;
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      
      let result = '';
      for (let i = 0; i < finalText.length; i++) {
        if (finalText[i] === ' ') {
          result += ' ';
        } else if (progress > (i / finalText.length)) {
          result += finalText[i];
        } else {
          result += chars[Math.floor(Math.random() * chars.length)];
        }
      }
      
      element.textContent = result;
      
      if (progress < 1) {
        requestAnimationFrame(animate);
      } else {
        element.textContent = finalText;
      }
    }
    
    requestAnimationFrame(animate);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const scrambleElements = document.querySelectorAll('[data-scramble]');
    scrambleElements.forEach((el, index) => {
      const target = el.querySelector('.scramble-text');
      const finalText = el.dataset.scramble;
      setTimeout(() => {
        scrambleText(target, finalText, 2500);
      }, index * 800);
    });
  });

  // === TYPEWRITER ===
  const description = "Automatizamos la captación, retención y operación de tu negocio con IA. Sin plantillas. Sin excusas.";
  const typewriterEl = document.querySelector('.typewriter-line');
  let charIndex = 0;
  
  function typeWriter() {
    if (charIndex < description.length) {
      typewriterEl.textContent += description.charAt(charIndex);
      charIndex++;
      setTimeout(typeWriter, 40 + Math.random() * 30);
    }
  }

  setTimeout(typeWriter, 3500);

  // === COUNTERS ===
  const counters = document.querySelectorAll('.metric-counter');
  const observerOptions = { threshold: 0.5, rootMargin: '0px' };

  const counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const counter = entry.target;
        const target = parseInt(counter.dataset.target);
        const duration = 2000;
        const startTime = performance.now();
        
        function updateCounter(currentTime) {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          counter.textContent = Math.floor(eased * target);
          
          if (progress < 1) {
            requestAnimationFrame(updateCounter);
          } else {
            counter.textContent = target;
          }
        }
        
        requestAnimationFrame(updateCounter);
        counterObserver.unobserve(counter);
      }
    });
  }, observerOptions);

  counters.forEach(counter => counterObserver.observe(counter));
</script>