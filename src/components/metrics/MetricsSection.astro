---
import { metricas, metricasHeader } from '../../data/metricas.js';
import MetricItem from './MetricItem.astro';
import MetricsAnimation from '../../react/MetricsAnimation.jsx';
---

<section id="metricas" class="relative py-20 md:py-32 lg:py-40 bg-dab-bg overflow-hidden">
  <!-- Fondo decorativo MUY sutil -->
  <div class="absolute inset-0 pointer-events-none opacity-30" aria-hidden="true">
    <div class="absolute top-1/4 left-0 w-64 h-64 md:w-96 md:h-96 bg-dab-accent/5 rounded-full blur-[80px] md:blur-[120px] metric-glow-1"></div>
    <div class="absolute bottom-1/4 right-0 w-64 h-64 md:w-96 md:h-96 bg-dab-accent/5 rounded-full blur-[80px] md:blur-[120px] metric-glow-2"></div>
  </div>

  <div class="relative z-10 max-w-[1280px] mx-auto px-5 md:px-12">
    <!-- Header -->
    <header class="text-center mb-16 md:mb-24 lg:mb-32 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 md:px-4 md:py-2 rounded-full border border-dab-border/30 bg-dab-surface/50 backdrop-blur-sm mb-6 md:mb-8 metric-header-badge">
        <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-dab-rose animate-pulse" aria-hidden="true"></span>
        <span class="font-mono text-[10px] md:text-xs uppercase tracking-[0.2em] text-dab-muted">
          {metricasHeader.label}
        </span>
      </div>
      
      <h2 class="font-body font-black text-[32px] md:text-[48px] lg:text-[64px] leading-[1.1] tracking-[-0.02em] lg:tracking-[-0.04em] text-dab-text mb-4 md:mb-6 metric-header-title">
        {metricasHeader.titulo}
      </h2>
      
      <p class="font-body font-normal text-sm md:text-base lg:text-lg text-dab-muted max-w-2xl mx-auto leading-relaxed metric-header-desc">
        {metricasHeader.descripcion}
      </p>
    </header>

    <!-- Métricas -->
    <div class="space-y-16 md:space-y-24 lg:space-y-32">
      {metricas.map((metrica, index) => (
        <MetricItem metrica={metrica} index={index} />
      ))}
    </div>
  </div>

  <!-- Animaciones GSAP -->
  <MetricsAnimation client:visible />
</section>
