---
const { metrica, index } = Astro.props;

const isEven = index % 2 === 0;
const layoutClass = isEven ? 'md:flex-row' : 'md:flex-row-reverse';
const numberAlign = isEven ? 'md:justify-start' : 'md:justify-end';
const textOffset = isEven ? 'md:pr-6 lg:pr-12' : 'md:pl-6 lg:pl-12';

// Mobile-first offsets: translate ±4% on tablet (md:), ±8% on desktop (lg:)
const offsetClass = isEven ? 'md:-translate-x-[4%] lg:-translate-x-[8%]' : 'md:translate-x-[4%] lg:translate-x-[8%]';

const colorTextClass = {
  rose: 'text-dab-rose',
  amber: 'text-dab-amber',
  cyan: 'text-dab-cyan'
};

const colorBgClass = {
  rose: 'bg-dab-rose/10',
  amber: 'bg-dab-amber/10',
  cyan: 'bg-dab-cyan/10'
};
---

<article 
  class={`metric-item flex flex-col ${layoutClass} items-center gap-8 md:gap-12 lg:gap-24 relative ${offsetClass}`}
  data-metrica-index={index}
>
  <!-- Número grande -->
  <div class={`w-full md:w-5/12 flex-shrink-0 relative flex ${numberAlign} justify-center`}>
    <!-- Glow decorativo (solo desktop) -->
    <div class="absolute -inset-4 md:-inset-8 lg:-inset-10 bg-dab-accent/5 rounded-full blur-2xl lg:blur-3xl -z-10 opacity-60 lg:opacity-100" aria-hidden="true"></div>
    
    <div class="metric-number flex items-baseline gap-1 md:gap-2">
      <span class="font-body font-black text-fluid-number leading-none tracking-[-0.04em] text-dab-accent">
        {metrica.numero}
      </span>
      {metrica.sufijo !== '%' && (
        <span class="font-body font-normal text-fluid-suffix text-dab-muted tracking-widest">
          {metrica.sufijo}
        </span>
      )}
      {metrica.sufijo === '%' && (
        <span class="font-body font-black text-fluid-number leading-none tracking-[-0.04em] text-dab-accent">
          %
        </span>
      )}
    </div>
  </div>

  <!-- Card de información -->
  <div class={`w-full md:w-7/12 flex flex-col items-start bg-dab-surface/60 backdrop-blur-xl border border-dab-border/50 p-6 md:p-8 lg:p-12 rounded-xl lg:rounded-2xl relative overflow-hidden group hover:border-dab-accent/30 transition-colors duration-500 metric-card ${textOffset}`}>
    <!-- Glow decorativo del color de la métrica (solo desktop/hover) -->
    <div class={`absolute top-0 ${isEven ? 'right-0' : 'left-0'} w-32 h-32 ${colorBgClass[metrica.colorLabel]} blur-2xl rounded-full ${isEven ? '-mr-16' : '-ml-16'} -mt-16`} aria-hidden="true"></div>
    
    <!-- Label -->
    <span class={`font-mono text-[10px] md:text-xs uppercase tracking-[0.2em] ${colorTextClass[metrica.colorLabel]} mb-3 md:mb-4 metric-label`}>
      {metrica.label}
    </span>
    
    <!-- Título -->
    <h3 class="font-body font-bold text-fluid-title text-dab-text mb-3 md:mb-4 leading-tight metric-titulo">
      {metrica.titulo}
    </h3>
    
    <!-- Descripción -->
    <p class="font-body font-normal text-sm md:text-base text-dab-muted mb-6 md:mb-8 leading-relaxed metric-descripcion">
      {metrica.descripcion}
    </p>
    
    <!-- Solución -->
    <div class="w-full flex items-center gap-3 md:gap-4 bg-dab-bg/50 border border-dab-border/30 rounded-lg p-3 md:p-4 metric-solucion">
      <span class="material-symbols-outlined text-dab-cyan text-xl md:text-2xl" aria-hidden="true">
        {metrica.solucion.icono}
      </span>
      <div>
        <p class="font-mono text-[10px] md:text-xs text-dab-cyan uppercase tracking-wider mb-1">
          {metrica.solucion.label}
        </p>
        <p class="font-body font-semibold text-sm md:text-base text-dab-text">
          {metrica.solucion.texto}
        </p>
      </div>
    </div>
  </div>
</article>

<style>
  .text-fluid-number {
    font-size: clamp(4rem, 8vw + 1rem, 8.75rem); /* 64px → 140px */
  }
  .text-fluid-suffix {
    font-size: clamp(1.125rem, 1vw + 0.75rem, 1.5rem); /* 18px → 24px */
  }
  .text-fluid-title {
    font-size: clamp(1.25rem, 2vw + 0.5rem, 2.0625rem); /* 20px → 33px */
  }
</style>
