---
import Container from '../ui/Container.astro';
import { categoriasFaq } from '../../data/faqs.js';
import { FaqClient } from './FaqClient.tsx';

const title = "Preguntas frecuentes";
const subtitle = "Elige tu servicio y encuentra respuestas claras. Si no está aquí, te respondemos en minutos.";
---

<section id="faq" class="py-16 md:py-section-y bg-dab-bg relative overflow-hidden">
  <!-- Decoración sutil -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-dab-accent/5 rounded-full blur-3xl pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <Container className="space-y-10 md:space-y-12 relative z-10">
    <!-- React component con lazy hydration -->
    <FaqClient client:visible categorias={categoriasFaq} title={title} subtitle={subtitle} />

    <!-- Fallback sin JS: todas las FAQs visibles en acordeón nativo -->
    <noscript>
      <div class="mb-10 md:mb-12 text-center px-3 sm:px-2 space-y-3 md:space-y-4">
        <h2 class="font-body font-bold text-2xl md:text-3xl tracking-tight leading-[1.15]">
          {title}
        </h2>
        <p class="font-body text-base text-dab-muted max-w-2xl mx-auto leading-relaxed">
          {subtitle}
        </p>
      </div>

      <div class="space-y-10">
        {
          categoriasFaq.map((cat) => (
            <div>
              <h3 class="text-lg font-semibold text-dab-text mb-4 font-body">
                {cat.label}
              </h3>
              <div class="space-y-3">
                {cat.faqs.map((faq, faqIndex) => (
                  <details
                    class="group rounded-2xl border border-dab-border/60 bg-dab-surface/50 backdrop-blur-sm overflow-hidden"
                    open={faqIndex === 0}
                  >
                    <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-left">
                      <span class="font-body text-base font-semibold text-dab-text leading-snug">
                        {faq.pregunta}
                      </span>
                      <span class="flex-shrink-0 flex items-center justify-center h-7 w-7 rounded-full border border-dab-border/60 text-dab-muted group-open:rotate-45 transition-transform duration-300">
                        <svg
                          width="12"
                          height="12"
                          viewBox="0 0 12 12"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                        >
                          <path d="M6 2v8M2 6h8" />
                        </svg>
                      </span>
                    </summary>

                    <div class="px-5 pb-5 pt-0">
                      <div class="border-t border-dab-border/40 pt-3">
                        <p class="font-body text-sm text-dab-muted leading-relaxed mb-4">
                          {faq.respuesta}
                        </p>
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </noscript>
  </Container>
</section>
