<style>
  .trust-banner {
    display: flex;
    align-items: center;
    height: 72px;
    background: #0a0a0a;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .banner-half {
    flex: 1;
    display: flex;
    align-items: center;
    overflow: hidden;
    height: 100%;
    position: relative;
    min-width: 0; /* Evita que el contenedor flex se desborde */
  }

  .banner-label {
    flex-shrink: 0;
    padding: 0 24px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #555;
    background: #0a0a0a;
    z-index: 10;
    position: relative;
    white-space: nowrap;
  }

  .banner-divider {
    width: 1px;
    height: 32px;
    background: #222;
    flex-shrink: 0;
  }

  .track-wrapper {
    flex: 1;
    overflow: hidden;
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    mask-image: linear-gradient(to right, transparent, black 30px, black calc(100% - 30px), transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 30px, black calc(100% - 30px), transparent);
  }

  .track {
    display: flex;
    align-items: center;
    gap: 40px;
    width: max-content;
    will-change: transform;
  }

  .track-wrapper:hover .track {
    animation-play-state: paused;
  }

  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes scroll-right {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  .track-left {
    animation: scroll-left 40s linear infinite;
  }

  .track-right {
    animation: scroll-right 45s linear infinite;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #888;
    transition: color 0.3s ease;
    flex-shrink: 0;
  }

  .item:hover {
    color: #fff;
  }

  .item span {
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
  }

  /* Cumplimiento */
  .compliance-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 107, 53, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .item-compliance svg {
    stroke: #ff6b35;
    stroke-width: 1.5;
    fill: none;
    width: 20px;
    height: 20px;
  }

  /* Tecnología */
  .item-tech svg {
    fill: currentColor;
    width: 20px;
    height: 20px;
    transition: fill 0.3s ease;
  }

  @media (max-width: 768px) {
    .banner-label {
      padding: 0 10px;
      font-size: 8px;
      letter-spacing: 0.1em;
    }
    .track {
      gap: 16px;
    }
    .item span {
      display: none; /* Oculta texto en móviles para mostrar al menos 2 iconos en cada sección */
    }
    .compliance-icon-wrap {
      width: 32px;
      height: 32px;
    }
    .item-compliance svg {
      width: 16px;
      height: 16px;
    }
    .item-tech svg {
      width: 18px;
      height: 18px;
    }
    .track-wrapper {
      mask-image: linear-gradient(to right, transparent, black 15px, black calc(100% - 15px), transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 15px, black calc(100% - 15px), transparent);
    }
  }
</style>
