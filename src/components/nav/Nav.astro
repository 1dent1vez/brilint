---
import { MobileNav } from '../../react/MobileNav.jsx';
import { NAV } from '../../data/hero';
---

<nav class="fixed top-0 w-full z-50 h-[72px] glass-panel transition-all duration-300">
  <div class="max-w-[1280px] mx-auto px-5 lg:px-12 h-full flex justify-between items-center">
    <!-- Brand Logo -->
    <a href={NAV.logoHref} class="flex items-center gap-2 cursor-pointer group">
      <!-- blur_on SVG icon -->
      <svg class="h-6 w-6 text-dab-accent group-hover:animate-pulse-glow transition-all fill-current" viewBox="0 -960 960 960" aria-hidden="true">
        <path d="M106-386q-6-6-6-14t6-14q6-6 14-6t14 6q6 6 6 14t-6 14q-6 6-14 6t-14-6Zm0-160q-6-6-6-14t6-14q6-6 14-6t14 6q6 6 6 14t-6 14q-6 6-14 6t-14-6Zm105.5 334.5Q200-223 200-240t11.5-28.5Q223-280 240-280t28.5 11.5Q280-257 280-240t-11.5 28.5Q257-200 240-200t-28.5-11.5Zm0-160Q200-383 200-400t11.5-28.5Q223-440 240-440t28.5 11.5Q280-417 280-400t-11.5 28.5Q257-360 240-360t-28.5-11.5Zm0-160Q200-543 200-560t11.5-28.5Q223-600 240-600t28.5 11.5Q280-577 280-560t-11.5 28.5Q257-520 240-520t-28.5-520Zm0-160Q200-703 200-720t11.5-28.5Q223-760 240-760t28.5 11.5Q280-737 280-720t-11.5 28.5Q257-680 240-680t-28.5-11.5Zm146 334Q340-375 340-400t17.5-42.5Q375-460 400-460t42.5 17.5Q460-425 460-400t-17.5 42.5Q425-340 400-340t-42.5-17.5Zm0-160Q340-535 340-560t17.5-42.5Q375-620 400-620t42.5 17.5Q460-585 460-560t-17.5 42.5Q425-500 400-500t-42.5-17.5Zm14 306Q360-223 360-240t11.5-28.5Q383-280 400-280t28.5 11.5Q440-257 440-240t-11.5 28.5Q417-200 400-200t-28.5-11.5Zm0-480Q360-703 360-720t11.5-28.5Q383-760 400-760t28.5 11.5Q440-737 440-720t-11.5 28.5Q417-680 400-680t-28.5-11.5ZM386-106q-6-6-6-14t6-14q6-6 14-6t14 6q6 6 6 14t-6 14q-6 6-14 6t-14-6Zm0-720q-6-6-6-14t6-14q6-6 14-6t14 6q6 6 6 14t-6 14q-6 6-14 6t-14-6Zm131.5 468.5Q500-375 500-400t17.5-42.5Q535-460 560-460t42.5 17.5Q620-425 620-400t-17.5 42.5Q585-340 560-340t-42.5-17.5Zm0-160Q500-535 500-560t17.5-42.5Q535-620 560-620t42.5 17.5Q620-585 620-560t-17.5 42.5Q585-500 560-500t-42.5-17.5Zm14 306Q520-223 520-240t11.5-28.5Q543-280 560-280t28.5 11.5Q600-257 600-240t-11.5 28.5Q600-200 560-200t-28.5-11.5Zm0-480Q520-703 520-720t11.5-28.5Q543-760 560-760t28.5 11.5Q600-737 600-720t-11.5 28.5Q577-680 560-680t-28.5-11.5ZM546-106q-6-6-6-14t6-14q6-6 14-6t14 6q6 6 6 14t-6 14q-6 6-14 6t-14-6Zm0-720q-6-6-6-14t6-14q6-6 14-6t14 6q6 6 6 14t-6 14q-6 6-14 6t-14-6Zm145.5 614.5Q680-223 680-240t11.5-28.5Q703-280 720-280t28.5 11.5Q760-257 760-240t-11.5 28.5Q737-200 720-200t-28.5-11.5Zm0-160Q680-383 680-400t11.5-28.5Q703-440 720-440t28.5 11.5Q760-417 760-400t-11.5 28.5Q737-360 720-360t-28.5-11.5Zm0-160Q680-543 680-560t11.5-28.5Q703-600 720-600t28.5 11.5Q760-577 760-560t-11.5 28.5Q737-520 720-520t-28.5-11.5Zm0-160Q680-703 680-720t11.5-28.5Q703-760 720-760t28.5 11.5Q760-737 760-720t-11.5 28.5Q737-680 720-680t-28.5-11.5ZM826-386q-6-6-6-14t6-14q6-6 14-6t14 6q6 6 6 14t-6 14q-6 6-14 6t-14-6Zm0-160q-6-6-6-14t6-14q6-6 14-6t14 6q6 6 6 14t-6 14q-6 6-14 6t-14-6Z"/>
      </svg>
      <span class="font-sans text-[32px] font-black tracking-tighter text-dab-text">{NAV.brand}</span>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-8 animate-fade-up">
      {
        NAV.links.map((link, idx) => (
          <a
            class={`font-mono text-[14px] uppercase tracking-[0.05em] leading-none transition-all duration-300 ${
              idx === 0
                ? 'text-dab-accent border-b-2 border-dab-accent pb-1'
                : 'text-dab-muted hover:text-dab-text hover:opacity-80'
            }`}
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Desktop CTA Button -->
    <div class="hidden md:flex items-center">
      <a
        class="bg-gradient-to-br from-[#608bff] to-[#b3c5ff] hover:brightness-110 shadow-[0_0_20px_rgba(76,127,255,0.2)] hover:shadow-[0_0_30px_rgba(76,127,255,0.4)] px-6 py-2.5 rounded-lg font-mono text-[14px] leading-none text-dab-bg font-bold active:scale-95 transition-all flex items-center gap-2"
        href={NAV.cta.href}
      >
        {NAV.cta.label}
        {NAV.cta.icon === 'arrow_forward' && (
          <svg class="h-4 w-4 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        )}
      </a>
    </div>

    <!-- Mobile Nav Wrapper -->
    <MobileNav
      client:load
      links={NAV.links}
      cta={NAV.cta}
      ariaLabel="Abrir menú de navegación"
      menuAriaLabel="Menú de navegación"
    />
  </div>
</nav>

<style>
  .glass-panel {
    background: rgba(11, 13, 20, 0.6);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-top: 1px solid rgba(179, 197, 255, 0.2);
    border-bottom: 1px solid rgba(31, 41, 51, 1);
  }
</style>
