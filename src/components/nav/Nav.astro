---
import { MobileNav } from '../../react/MobileNav.jsx';
import { NAV } from '../../data/hero';
import LiquidCtaButton from '../../react/LiquidCtaButton.jsx';
---

<nav class="fixed top-0 w-full z-50 h-[72px] liquid-surface rounded-none overflow-visible transition-all duration-300">
  <div class="max-w-[1280px] mx-auto px-5 lg:px-12 h-full flex justify-between items-center">
    <!-- Brand Logo -->
    <a href={NAV.logoHref} class="flex items-center gap-2 cursor-pointer group">
      <img src="/dab3.svg" alt="DAB Logo" class="h-12 sm:h-14 w-auto transition-transform duration-300 group-hover:scale-[1.03]" />
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-8 animate-fade-up">
      {
        NAV.links.map((link, idx) => (
          <a
            class="font-mono text-[13.5px] uppercase tracking-[0.05em] leading-none transition-all duration-300 text-dab-muted hover:text-dab-accent"
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Desktop CTA Button -->
    <div class="hidden md:flex items-center">
      <LiquidCtaButton
        href={NAV.cta.href}
        client:load
        tint="rgba(59, 91, 255, 0.18)"
        textClass="text-dab-cyan"
        turbulenceSeed={4}
      >
        {NAV.cta.label}
        {NAV.cta.icon === 'arrow_forward' && (
          <svg class="h-4 w-4 text-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        )}
      </LiquidCtaButton>
    </div>

    <!-- Mobile Nav Wrapper -->
    <MobileNav
      client:load
      links={NAV.links}
      cta={NAV.cta}
      ariaLabel="Abrir menú de navegación"
      menuAriaLabel="Menú de navegación"
    />
  </div>
</nav>
