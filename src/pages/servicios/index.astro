---
import DefaultLayout from '../../layouts/DefaultLayout.astro';
import Nav from '../../components/nav/Nav.astro';
import Footer from '../../components/footer/Footer.astro';
import Container from '../../components/ui/Container.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import { serviciosGenerales } from '../../data/servicios-generales';
import { WHATSAPP_URL } from '../../config/contact';

// Bullet CTA del mismo tamaño que una ficha de servicio.
const ctaMitad = WHATSAPP_URL('Hola, no sé por dónde empezar. ¿Me ayudan a armar mi paquete?');
const ctaFinal = WHATSAPP_URL('Hola, quiero armar mi paquete a la medida de mi negocio');

// Insertar el CTA de mitad tras el 4o servicio (índice 3).
const mitadIdx = 3;
---

<DefaultLayout
  title="Servicios — DAB"
  description="Todo lo que hacemos por tu negocio. Los paquetes los armamos según lo que tu negocio necesite."
>
  <Nav />

  <main class="bg-dab-bg pt-[72px]">
    <section class="py-16 md:py-section-y">
      <Container className="space-y-10 md:space-y-12">
        <SectionTitle
          title="Todo lo que hacemos por tu negocio"
          subtitle="No vendemos paquetes cerrados: detectamos las necesidades de tu negocio y armamos la solución a tu medida con los servicios que ofrecemos."
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {
            serviciosGenerales.map((servicio, idx) => (
              <>
                <article class="glass-card rounded-2xl p-6 sm:p-7 flex flex-col h-full transition duration-300 hover:border-dab-accent/40">
                  <div class="space-y-3 flex-1">
                    <h3 class="font-body text-xl font-bold tracking-tight text-white">
                      {servicio.titulo}
                    </h3>
                    <p class="font-body text-sm text-dab-muted leading-relaxed">
                      {servicio.descripcion}
                    </p>
                  </div>
                </article>

                {idx === mitadIdx && (
                  <article class="glass-card rounded-2xl p-6 sm:p-7 flex flex-col h-full justify-center items-center text-center gap-4 border-dab-accent/30 bg-dab-accent/5 cta-pulso">
                    <p class="font-body text-base sm:text-lg text-white font-semibold">
                      ¿No sabes por dónde empezar?
                    </p>
                    <a
                      href={ctaMitad}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="cta-btn group inline-flex items-center justify-center font-body font-semibold text-sm px-6 py-3 rounded-lg bg-dab-accent text-dab-bg hover:bg-dab-accent/90 active:scale-[0.97] transition-all shadow-dab-accent/20 hover:shadow-dab-accent/40"
                    >
                      Hablemos y te armamos el paquete <span class="cta-arrow ml-1 transition-transform duration-300">→</span>
                    </a>
                  </article>
                )}
              </>
            ))
          }

          <!-- CTA final tras el último servicio -->
          <article class="glass-card rounded-2xl p-6 sm:p-7 flex flex-col h-full justify-center items-center text-center gap-4 border-dab-accent/30 bg-dab-accent/5 cta-pulso">
            <p class="font-body text-base sm:text-lg text-white font-semibold">
              Tu negocio es único.
            </p>
            <a
              href={ctaFinal}
              target="_blank"
              rel="noopener noreferrer"
              class="cta-btn group inline-flex items-center justify-center font-body font-semibold text-sm px-6 py-3 rounded-lg bg-dab-accent text-dab-bg hover:bg-dab-accent/90 active:scale-[0.97] transition-all shadow-dab-accent/20 hover:shadow-dab-accent/40"
            >
              Armar mi paquete a la medida <span class="cta-arrow ml-1 transition-transform duration-300">→</span>
            </a>
          </article>
        </div>
      </Container>
      </section>
      </main>

      <Footer />
      </DefaultLayout>

      <style>
      /* CTA: pulso magnético (anillo que se expande) */
      .cta-pulso {
      position: relative;
      }
      .cta-pulso::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      border: 1px solid rgba(76, 127, 255, 0.6);
      animation: cta-pulse 2.4s ease-out infinite;
      pointer-events: none;
      }
      @keyframes cta-pulse {
      0%   { transform: scale(1);    opacity: 0.7; }
      70%  { transform: scale(1.04); opacity: 0; }
      100% { transform: scale(1.04); opacity: 0; }
      }

      /* Botón: shimmer diagonal que cruza de vez en cuando */
      .cta-btn {
      position: relative;
      overflow: hidden;
      }
      .cta-btn::after {
      content: "";
      position: absolute;
      top: 0;
      left: -60%;
      width: 50%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.45),
        transparent
      );
      transform: skewX(-20deg);
      animation: cta-shimmer 3.6s ease-in-out infinite;
      }
      @keyframes cta-shimmer {
      0%, 55%   { left: -60%; }
      80%, 100% { left: 130%; }
      }

      /* Flecha que viaja: loop suave ida/vuelta + disparo en hover */
      .cta-arrow {
      animation: cta-arrow 1.8s ease-in-out infinite;
      }
      .cta-btn:hover .cta-arrow {
      animation: none;
      transform: translateX(5px);
      }
      @keyframes cta-arrow {
      0%, 100% { transform: translateX(0); }
      50%      { transform: translateX(5px); }
      }

      @media (prefers-reduced-motion: reduce) {
      .cta-pulso::before,
      .cta-btn::after,
      .cta-arrow {
        animation: none !important;
        transform: none !important;
      }
      .cta-btn:hover .cta-arrow {
        transform: none;
      }
      }
      </style>
