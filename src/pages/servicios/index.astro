---
import DefaultLayout from '../../layouts/DefaultLayout.astro';
import Nav from '../../components/nav/Nav.astro';
import Footer from '../../components/footer/Footer.astro';
import Container from '../../components/ui/Container.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import Button from '../../components/ui/Button.astro';
import { serviciosGenerales } from '../../data/servicios-generales';
import { WHATSAPP_URL } from '../../config/contact';
---

<DefaultLayout
  title="Servicios — DAB"
  description="Todo lo que hacemos por tu negocio. Los paquetes los armamos según lo que tu negocio necesite."
>
  <Nav />

  <main class="bg-dab-bg pt-[72px]">
    <section class="py-16 md:py-section-y">
      <Container className="space-y-10 md:space-y-12">
        <SectionTitle
          title="Todo lo que hacemos por tu negocio"
          subtitle="No vendemos paquetes cerrados: detectamos las necesidades de tu negocio y armamos la solución a tu medida. Estos son los servicios con los que lo hacemos."
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {
            serviciosGenerales.map((servicio) => (
              <article class="glass-card rounded-2xl p-6 sm:p-7 flex flex-col h-full transition duration-300 hover:border-dab-accent/40">
                <div class="space-y-3 flex-1">
                  <h3 class="font-body text-xl font-bold tracking-tight text-white">
                    {servicio.titulo}
                  </h3>
                  <p class="font-body text-sm text-dab-muted leading-relaxed">
                    {servicio.descripcion}
                  </p>
                  <p class="font-body text-xs text-dab-accent/80 leading-relaxed pt-1">
                    {servicio.bullet}
                  </p>
                </div>

                <a
                  href={servicio.ctaHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-6 inline-flex items-center justify-center w-full font-body font-medium text-sm py-3 px-6 rounded-lg bg-transparent border border-dab-border text-dab-text hover:border-dab-accent/40 hover:bg-white/5 active:scale-[0.98] transition-all"
                >
                  Quiero este servicio
                  <span class="ml-1 text-white opacity-60 group-hover:opacity-100 transition-opacity">→</span>
                </a>
              </article>
            ))
          }
        </div>

        <div class="text-center pt-4 space-y-4">
          <p class="font-body text-base text-dab-muted max-w-xl mx-auto leading-relaxed">
            ¿No sabes por dónde empezar? Hablemos y armamos tu paquete a la medida de tu negocio.
          </p>
          <Button href={WHATSAPP_URL('Hola, quiero armar mi paquete a medida')} variant="primary">
            Armar mi paquete
          </Button>
        </div>
      </Container>
    </section>
  </main>

  <Footer />
</DefaultLayout>
