---
import DefaultLayout from '../layouts/DefaultLayout.astro';
import Nav from '../components/nav/Nav.astro';
import Services from '../components/services/Services.astro';
import Proceso from '../components/proceso/Proceso.astro';
import ContactSection from '../components/form/ContactSection.astro';
import FAQ from '../components/sections/Faq.astro';
import CTA from '../components/cta/CTA.astro';
import MuroConfianza from '../components/muro-confianza/MuroConfianza.astro';
import Footer from '../components/footer/Footer.astro';
import Hero from '../components/hero/Hero.astro';
import MetricsSection from '../components/metrics/MetricsSection.astro';
import TrustBanner from '../components/sections/TrustBanner.astro';
---

<DefaultLayout
  title="DAB — IA & Automatización"
  description="Socios de crecimiento. Evolucionamos juntos o no evolucionamos. Tu éxito es el nuestro."
>
  <Nav />

  <main class="bg-dab-bg relative">
    <!-- Aurora de fondo global: da "algo detrás" para que el glass líquido refracte -->
    <div class="liquid-aurora" aria-hidden="true"></div>

    <Hero />
    <MetricsSection />
    <Services />
    
    <TrustBanner />

    <Proceso />
    <MuroConfianza />
    <FAQ />
    
    <CTA />
  </main>

  <Footer />
</DefaultLayout>
