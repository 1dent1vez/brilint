---
import '../styles/base.css';
import { WHATSAPP_URL } from '../config/contact';

const {
  title = 'Dab — Servicios digitales premium',
  description: pageDescription = 'Consultora de servicios digitales para PyMEs, profesionales y hogares del Valle de Toluca.',
} = Astro.props;
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />

    <!-- Mejora móvil REAL -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
   <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <!-- Forzar dark mode consistente -->
    <meta name="color-scheme" content="dark only" />

    <title>{title}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="/og-image.webp" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={Astro.site} />

    <!-- Fuentes Web Centralizadas: Inter + JetBrains Mono + Cormorant Garamond -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block"
    />

    <!-- JSON-LD -->
    <script type="application/ld+json">
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: 'Dab',
        image: new URL('og-image.webp', Astro.site).href,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Metepec',
          addressRegion: 'Estado de México',
        },
        url: Astro.site.href,
        telephone: '+52 1 7223579869',
        servesLocation: ['Metepec', 'Toluca', 'Lerma', 'San Mateo Atenco'],
        description: pageDescription,
      })}
    </script>

    <!-- Calendly Widget CSS -->
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  </head>

  <body class="relative bg-dab-bg text-dab-text">
    <!-- Contenido de la página -->
    <slot />

    <!-- BOTÓN FLOTANTE WHATSAPP -->
    <a
      href={WHATSAPP_URL("Hola, quiero más información sobre Dab")}
      aria-label="Hablar por WhatsApp"
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-5 right-4 sm:bottom-8 sm:right-8 z-40 inline-flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl shadow-[#25D366]/30 hover:bg-[#20ba5a] active:scale-95 transition-all duration-300 hover:shadow-[#25D366]/50"
    >
      <svg class="h-6 w-6 sm:h-7 sm:w-7 fill-current" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.513 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.665.989 3.3.15 5.4.15 5.51 0 9.995-4.485 9.999-10.001.002-2.672-1.037-5.184-2.927-7.075C17.23 3.86 14.73 2.82 12.062 2.82c-5.521 0-10.01 4.486-10.014 10.002-.002 2.083.523 4.113 1.521 5.923l.165.297-.996 3.636 3.72-.976.299.177zM16.59 13.911c-.24-.12-1.424-.703-1.646-.784-.223-.08-.386-.12-.549.12-.162.24-.629.784-.771.945-.143.161-.285.18-.525.06-.24-.12-1.014-.374-1.932-1.194-.714-.637-1.197-1.425-1.337-1.666-.14-.24-.015-.37.106-.49.109-.108.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.55-1.325-.753-1.814-.197-.476-.399-.412-.549-.42-.143-.008-.308-.01-.472-.01-.164 0-.432.06-.658.307-.226.248-.863.843-.863 2.057 0 1.214.883 2.383.98 2.545.097.161 1.737 2.653 4.207 3.719.587.254 1.046.406 1.403.52.59.187 1.127.16 1.551.097.472-.07 1.424-.582 1.626-1.144.203-.562.203-1.044.142-1.144-.06-.1-.22-.16-.46-.28z"/>
      </svg>
    </a>

    <!-- Calendly Widget JS & Handler -->
    <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
    <script is:inline>
      document.addEventListener('click', (e) => {
        const target = e.target.closest('a');
        if (target && target.href && target.href.includes('calendly.com/dabagency/30min')) {
          e.preventDefault();
          if (window.Calendly) {
            window.Calendly.initPopupWidget({ url: target.href });
          } else {
            window.open(target.href, '_blank');
          }
        }
      });
    </script>
  </body>
</html>
