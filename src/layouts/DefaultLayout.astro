---
import '../styles/liquid.css';
import '../styles/base.css';
import { WHATSAPP_URL } from '../config/contact';
import LiquidCtaButton from '../react/LiquidCtaButton.jsx';

const {
  title = 'DAB — Servicios digitales premium',
  description: pageDescription = 'Consultora de servicios digitales para PyMEs, profesionales y hogares del Valle de Toluca.',
  canonical,
} = Astro.props;
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />

    <!-- Mejora móvil REAL -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
   <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <!-- Forzar dark mode consistente -->
    <meta name="color-scheme" content="dark only" />

    <title>{title}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="/og-image.webp" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical ?? new URL(Astro.url.pathname, Astro.site).href} />

    <!-- Fuentes Web Centralizadas: Inter + JetBrains Mono + Cormorant Garamond -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block"
    />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: 'DAB',
      image: new URL('og-image.webp', Astro.site).href,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Metepec',
        addressRegion: 'Estado de México',
        addressCountry: 'MX',
      },
      areaServed: [
        { '@type': 'City', name: 'Toluca' },
        { '@type': 'City', name: 'Metepec' },
        { '@type': 'City', name: 'Zinacantepec' },
        { '@type': 'City', name: 'Lerma' },
        { '@type': 'City', name: 'San Mateo Atenco' },
      ],
      url: new URL('/', Astro.site).href,
      telephone: '+52 1 7223579869',
      priceRange: '$$',
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '11:00',
          closes: '18:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Saturday'],
          opens: '12:00',
          closes: '15:00',
        },
      ],
      description: pageDescription,
    })} />

    <!-- Calendly Widget CSS -->
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  </head>

  <body class="relative bg-dab-bg text-dab-text">
    <!-- Contenido de la página -->
    <slot />

    <!-- BOTÓN FLOTANTE WHATSAPP (liquid glass, siempre visible, circular, esquina inferior derecha) -->
    <a
      href={WHATSAPP_URL("Hola, quiero más información sobre Dab")}
      aria-label="Hablar por WhatsApp"
      target="_blank"
      rel="noopener noreferrer"
      class="liquid-surface liquid-surface--whatsapp fixed bottom-5 right-4 sm:bottom-8 sm:right-8 z-40 flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center rounded-full text-[#25D366] shadow-[0_0_20px_rgba(37,211,102,0.25)] transition-transform duration-200 hover:scale-105 active:scale-95"
    >
      <svg class="h-6 w-6 sm:h-7 sm:w-7 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.464 3.489"/>
      </svg>
    </a>

    <!-- Calendly Widget JS & Handler -->
    <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
    <script is:inline>
      document.addEventListener('click', (e) => {
        const target = e.target.closest('a');
        if (target && target.href && target.href.includes('calendly.com/dabagency/30min')) {
          e.preventDefault();
          if (window.Calendly) {
            window.Calendly.initPopupWidget({ url: target.href });
          } else {
            window.open(target.href, '_blank');
          }
        }
      });
    </script>
  </body>
</html>
