---
import '../styles/base.css';
import { WHATSAPP_URL } from '../config/contact';

const {
  title = 'Dab — Servicios digitales premium',
  description: pageDescription = 'Consultora de servicios digitales para PyMEs, profesionales y hogares del Valle de Toluca.',
} = Astro.props;
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />

    <!-- Mejora móvil REAL -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
   <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <!-- Forzar dark mode consistente -->
    <meta name="color-scheme" content="dark only" />

    <title>{title}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="/og-image.webp" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={Astro.site} />

    <!-- Fuentes Web Centralizadas: Inter + JetBrains Mono + Cormorant Garamond -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block"
    />

    <!-- JSON-LD -->
    <script type="application/ld+json">
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: 'Dab',
        image: new URL('og-image.webp', Astro.site).href,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Metepec',
          addressRegion: 'Estado de México',
        },
        url: Astro.site.href,
        telephone: '+52 1 7223579869',
        servesLocation: ['Metepec', 'Toluca', 'Lerma', 'San Mateo Atenco'],
        description: pageDescription,
      })}
    </script>

    <!-- Calendly Widget CSS -->
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  </head>

  <body class="relative bg-dab-bg text-dab-text">
    <!-- Contenido de la página -->
    <slot />

    <!-- BOTÓN FLOTANTE SOLO MÓVIL -->
    <a
      href={WHATSAPP_URL("Hola, quiero más información sobre Dab")}
      aria-label="Hablar por WhatsApp"
      class="fixed bottom-5 right-4 z-40 inline-flex h-12 w-12 items-center justify-center rounded-full bg-dab-accent text-dab-bg shadow-xl shadow-dab-accent/40 md:hidden active:scale-95 transition"
    >
      W
    </a>

    <!-- Calendly Widget JS & Handler -->
    <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
    <script is:inline>
      document.addEventListener('click', (e) => {
        const target = e.target.closest('a');
        if (target && target.href && target.href.includes('calendly.com/dabagency/30min')) {
          e.preventDefault();
          if (window.Calendly) {
            window.Calendly.initPopupWidget({ url: target.href });
          } else {
            window.open(target.href, '_blank');
          }
        }
      });
    </script>
  </body>
</html>
